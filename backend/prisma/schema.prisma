generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model User {
  id        Int     @id @default(autoincrement())
  name      String
  email     String  @unique
  password  String
  token     Int     @default(100)
  role      Role    @default(FREE)
}

enum Role {
  FREE
  PRO
  PREMIUM
}